{
  "info": {
    "name": "plangit — Planning API",
    "description": "CRUD requests for plangit's v1 domain model (Codeline, PlannedCommit, PlannedEvent, Milestone, TeamMember). Each entity folder's \"Create\" request captures the new resource's id into a collection variable via a test script, so the other requests in that folder (and other folders that reference it) can chain off it without manual copy-paste. Run folders top to bottom the first time: Codelines -> Team Members -> Milestones -> Planned Commits -> Planned Events.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api", "type": "string" },
    { "key": "codelineId", "value": "", "type": "string" },
    { "key": "branchCodelineId", "value": "", "type": "string" },
    { "key": "teamMemberId", "value": "", "type": "string" },
    { "key": "milestoneId", "value": "", "type": "string" },
    { "key": "plannedCommitId", "value": "", "type": "string" },
    { "key": "plannedEventId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Codelines",
      "item": [
        {
          "name": "Create Codeline (trunk)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('codelineId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/codelines", "host": ["{{baseUrl}}"], "path": ["codelines"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"trunk\",\n  \"color\": \"#2a78d6\"\n}"
            }
          }
        },
        {
          "name": "Create Codeline (branch off trunk)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('branchCodelineId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/codelines", "host": ["{{baseUrl}}"], "path": ["codelines"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"branches/release-2.4\",\n  \"parent_codeline_id\": \"{{codelineId}}\",\n  \"branch_point_date\": \"2026-08-01\"\n}"
            }
          }
        },
        {
          "name": "List Codelines",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/codelines", "host": ["{{baseUrl}}"], "path": ["codelines"] }
          }
        },
        {
          "name": "Get Codeline by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/codelines/{{codelineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["codelines", "{{codelineId}}"]
            }
          }
        },
        {
          "name": "Update Codeline",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/codelines/{{codelineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["codelines", "{{codelineId}}"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"color\": \"#008300\"\n}"
            }
          }
        },
        {
          "name": "Delete Codeline",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/codelines/{{codelineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["codelines", "{{codelineId}}"]
            }
          }
        }
      ]
    },
