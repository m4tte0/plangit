flowchart TB
    subgraph Frontend["Planning Board — React"]
      UI["Lanes + Calendar Renderer"]
      DnD["Drag/Drop Scheduler"]
    end

    subgraph Backend["Planning API"]
      API["REST/GraphQL Endpoints"]
      Svc["Domain Service Layer"]
    end

    subgraph Storage["Persistence"]
      DB[("Postgres / SQLite")]
    end

    subgraph Reconciliation["Reconciliation Service — Phase 2"]
      Job["Scheduled Job (GitHub Action)"]
      Parser["SVN Log XML Parser"]
      Matcher["Date + Path Matcher"]
    end

    subgraph VCS["Version Control"]
      SVN[("SVN Repository")]
    end

    UI --> API
    DnD --> API
    API --> Svc
    Svc --> DB
    Job --> SVN
    SVN --> Parser
    Parser --> Matcher
    Svc --> Matcher
    Matcher --> Svc
